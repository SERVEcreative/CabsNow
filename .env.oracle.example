# Copy to .env on the VM and fill in your values:
#   cp .env.oracle.example .env
#   nano .env

# Your VM public IP (Oracle Console → Compute → Instance → Public IP)
PUBLIC_APP_URL=http://YOUR_VM_PUBLIC_IP

# Database — use strong passwords in production
MYSQL_ROOT_PASSWORD=change_this_root_password
MYSQL_PASSWORD=change_this_cabsnow_password

# JWT signing key — at least 32 characters, random
JWT_SECRET=ChangeThisToRandomSecretKeyAtLeast32Chars!!

# Default admin (created on first boot if missing)
ADMIN_PASSWORD=ChangeThisAdminPassword123!
